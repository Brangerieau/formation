{# data-turbo-permanent keeps the conversation across Turbo page visits; a full reload re-renders it from the session. #}
<details id="chat" class="chat" data-turbo-permanent data-controller="chat" data-chat-url-value="{{ path('chat') }}" data-chat-reset-url-value="{{ path('chat_reset') }}" data-chat-confirm-url-value="{{ path('chat_confirm') }}" data-chat-cancel-url-value="{{ path('chat_cancel') }}">
    <summary>Assistant</summary>
    <div class="chat-log" data-chat-target="log" aria-live="polite">
        {{- include('chat/_transcript.html.twig', {items: chat_transcript()}) }}
    </div>
    <form data-chat-target="form" data-action="chat#send">
        <input type="text" data-chat-target="input" aria-label="Votre message" placeholder="Votre message" maxlength="2000" autocomplete="off" required>
        {# Icons: Lucide send-horizontal / trash-2 (ISC). #}
        <button aria-label="Envoyer" title="Envoyer">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 3 9-3 9 19-9Z"/><path d="M6 12h16"/></svg>
        </button>
        <button type="button" class="chat-reset" data-action="chat#reset" aria-label="Effacer la conversation" title="Effacer la conversation">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
        </button>
    </form>
</details>
