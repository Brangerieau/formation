{% for item in items %}
    {% if item.type == 'tool' %}
        {# The id lets the widget replace the card when the action is confirmed or cancelled. #}
        <details id="chat-tool-{{ item.id }}" class="chat-tool chat-tool-{{ item.status }}"{% if item.status == 'pending' %} open{% endif %}>
            <summary>
                {{ item.label }}{% if item.arguments %} <span class="chat-tool-args">({{ item.arguments }})</span>{% endif %}
                <span class="chat-tool-status">{{ {ok: 'ok', error: 'erreur', pending: 'à confirmer', skipped: 'non exécuté', cancelled: 'annulé'}[item.status] }}</span>
            </summary>
            {% if item.status == 'pending' %}
                <div class="chat-tool-confirm">
                    {# Icons: Lucide thumbs-up / thumbs-down (ISC). #}
                    <button type="button" class="chat-tool-yes" data-action="chat#confirm" aria-label="Confirmer" title="Confirmer">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg>
                    </button>
                    <button type="button" class="chat-tool-no" data-action="chat#cancel" aria-label="Annuler" title="Annuler">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 14V2"/><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88Z"/></svg>
                    </button>
                </div>
            {% else %}
                <pre>{{ item.result }}</pre>
            {% endif %}
        </details>
    {% else %}
        <p class="chat-msg chat-msg-{{ item.role }}">{{ item.content }}</p>
    {% endif %}
{% endfor %}
